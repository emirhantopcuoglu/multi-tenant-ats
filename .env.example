# Copy to .env for docker-compose. Leaving a value out falls back to the dev default.

# MinIO root credentials. Dev default is minioadmin/minioadmin.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# RabbitMQ credentials, also used for the management UI at http://localhost:15672.
# Dev default is ats/ats_dev_password.
RABBITMQ_USER=ats
RABBITMQ_PASSWORD=change-me

# The API doesn't read this file. Its secrets come from User Secrets (run in src/Ats.Api):
#   dotnet user-secrets set "Jwt:Secret" "<at least 32 random characters>"
#   dotnet user-secrets set "FileStorage:AccessKey" "<MINIO_ROOT_USER>"
#   dotnet user-secrets set "FileStorage:SecretKey" "<MINIO_ROOT_PASSWORD>"
#   dotnet user-secrets set "Llm:ApiKey" "github_pat_..."
#
# Llm:ApiKey is for CV parsing. Any OpenAI-compatible API works; the default is GitHub Models, which
# needs a token with Models: Read. To switch provider, change Llm:BaseUrl and Llm:Model in
# appsettings.json.
#
# Postgres, MongoDB, Redis and RabbitMQ connection settings live in appsettings.json. Override them
# the same way for a remote server, e.g. "Mongo:ConnectionString" or "RabbitMq:Password".

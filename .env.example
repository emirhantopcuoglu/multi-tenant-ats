POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5434
JWT_SECRET=change-me-long-random

# MinIO root credentials (docker-compose). Dev defaults to minioadmin/minioadmin.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# The API's storage credentials are read from User Secrets, not this file:
#   dotnet user-secrets set "FileStorage:AccessKey" "minioadmin"
#   dotnet user-secrets set "FileStorage:SecretKey" "<MINIO_ROOT_PASSWORD>"

# MongoDB (activity log). Dev runs without auth, so the connection string in appsettings.json is
# enough. For a shared/remote MongoDB, enable auth and override via:
#   dotnet user-secrets set "Mongo:ConnectionString" "mongodb://user:pass@host:27017"

# Redis (distributed cache). Dev runs without auth, so the connection string in appsettings.json is
# enough. For a shared/remote Redis, enable auth and override via:
#   dotnet user-secrets set "Redis:ConnectionString" "host:6379,password=<secret>,ssl=true"

# RabbitMQ message broker (docker-compose). Dev defaults to ats/ats_dev_password; the management UI is
# at http://localhost:15672 with these same credentials.
RABBITMQ_USER=ats
RABBITMQ_PASSWORD=change-me

# The API reads the broker credentials from appsettings.json in dev. For a shared/remote broker,
# override via User Secrets:
#   dotnet user-secrets set "RabbitMq:Host" "host"
#   dotnet user-secrets set "RabbitMq:Username" "user"
#   dotnet user-secrets set "RabbitMq:Password" "<secret>"

# Hangfire background jobs (Sprint 5.4) reuse the Postgres connection above for storage, so there is no
# new secret here. The dashboard at http://localhost:5000/hangfire is restricted to localhost in dev;
# exposing it remotely requires real authentication (production hardening, Sprint 8).

# Messaging resilience (Sprint 5.5) needs no new secret. Consumer retry/dead-letter is tuned via the
# "RabbitMq" section in appsettings.json (RetryLimit/RetryInitialIntervalSeconds/RetryMaxIntervalSeconds),
# and the idempotency guard reuses the Redis connection above with its retention set in the
# "Idempotency" section.

# LLM for CV parsing (Sprint 6.3) — any OpenAI-compatible API. Defaults to GitHub Models, which is
# free with a GitHub token. The BaseUrl/Model/timeout/retry live in the "Llm" section of
# appsettings.json; only the key is a secret and is read from User Secrets. The key is a GitHub PAT
# with Models access (github.com/settings/personal-access-tokens, Account permissions -> Models: Read):
#   dotnet user-secrets set "Llm:ApiKey" "github_pat_..."
# To switch providers, change Llm:BaseUrl + Llm:Model and use that provider's key (e.g. Groq:
#   BaseUrl https://api.groq.com/openai/v1 , Model llama-3.3-70b-versatile , key gsk_...).

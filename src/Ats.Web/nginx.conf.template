# Serves the built SPA. Two jobs: client-side routing fallback, and sane caching for a hashed build.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers. These are inherited by any location that doesn't define its own add_header,
    # so the locations below use only `expires` (which doesn't break that inheritance) to keep them.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Scripts, styles and fonts only from this origin, requests only to it and the API. An injected
    # script doesn't run, and one that did couldn't send anything elsewhere. ${API_ORIGIN} is filled
    # in when the container starts (see the Dockerfile). Inline styles are allowed because Radix adds a
    # <style> to lock scrolling; injected CSS can't leak data while images and fonts are self-only.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' ${API_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Vite emits content-hashed filenames under /assets, so a file's content never changes behind its
    # name — it's safe to cache for a year.
    location /assets/ {
        expires 1y;
    }

    # The entry document must never be cached, or a deploy's new asset hashes won't be picked up.
    location = /index.html {
        expires -1;
    }

    # Client-side routing: any unknown path is a React Router route, not a file, so fall back to the
    # SPA shell instead of returning 404.
    location / {
        try_files $uri $uri/ /index.html;
    }
}

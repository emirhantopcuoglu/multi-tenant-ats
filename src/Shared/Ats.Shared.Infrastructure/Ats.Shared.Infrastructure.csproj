<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Ats.Shared.Kernel\Ats.Shared.Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Email wording ships inside the assembly, not beside it: these files are source, and an
       operator editing an email body on a server is not a scenario worth supporting.

       WithCulture=false is required, not decorative. MSBuild reads the second-to-last dot segment of
       a resource file name as a culture, so "EmailText.en.json" would be treated as the English
       satellite of a resource called "EmailText" and compiled into en\*.resources.dll instead of the
       main assembly — where GetManifestResourceStream would never find it. -->
  <ItemGroup>
    <EmbeddedResource Include="EmailText\*.json" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="11.10.0" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.0" />
    <PackageReference Include="Minio" Version="6.0.3" />
    <PackageReference Include="MongoDB.Driver" Version="3.9.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="Polly.Core" Version="8.7.0" />
    <PackageReference Include="prometheus-net" Version="8.2.1" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.58" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

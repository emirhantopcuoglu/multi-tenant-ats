{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "MassTransit": "Warning",
        "Hangfire": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId,-36} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "Mongo": {
    "DatabaseName": "ats"
  },
  "RabbitMq": {
    "Port": 5672,
    "VirtualHost": "/",
    "RetryLimit": 5,
    "RetryInitialIntervalSeconds": 2,
    "RetryMaxIntervalSeconds": 30
  },
  "Idempotency": {
    "RetentionHours": 24
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PerIpPermitLimit": 5,
    "PerUserPermitLimit": 60,
    "PerTenantPermitLimit": 100,
    "WindowSeconds": 60
  },
  "LoginLockout": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "Jwt": {
    "Issuer": "ats",
    "Audience": "ats",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Email": {
    "FromName": "ATS",
    "UseSsl": false
  },
  "Invitation": {
    "ValidDays": 7
  },
  "PasswordReset": {
    "ValidMinutes": 60
  },
  "FileStorage": {
    "BucketName": "cv-uploads",
    "UseSsl": false,
    "MaxFileSizeBytes": 10485760
  },
  "Hangfire": {
    "ExpiredInvitationCleanupCron": "0 0 * * *",
    "InterviewReminderCron": "*/5 * * * *",
    "OrphanFileCleanupCron": "0 3 * * *",
    "CandidateAccountDeletionCron": "0 2 * * *",
    "ClosedApplicationRetentionCron": "30 2 * * *"
  },
  "Retention": {
    "ClosedApplicationMonths": 12
  },
  "Metrics": {
    "Port": 9464
  },
  "OpenTelemetry": {
    "ServiceName": "ats-api",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Llm": {
    "BaseUrl": "https://api.groq.com/openai/v1",
    "Model": "openai/gpt-oss-120b",
    "MaxOutputTokens": 2048,
    "MaxCvCharacters": 12000,
    "MaxJobDescriptionCharacters": 6000,
    "TimeoutSeconds": 30
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=127.0.0.1;Port=5434;Database=ats;Username=ats;Password=ats_dev_password"
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "ats"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "ats",
    "Password": "ats_dev_password",
    "RetryLimit": 5,
    "RetryInitialIntervalSeconds": 2,
    "RetryMaxIntervalSeconds": 30
  },
  "Idempotency": {
    "RetentionHours": 24
  },
  "RateLimiting": {
    "PerIpPermitLimit": 5,
    "PerUserPermitLimit": 60,
    "PerTenantPermitLimit": 100,
    "WindowSeconds": 60
  },
  "Jwt": {
    "Issuer": "ats",
    "Audience": "ats",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "FromAddress": "noreply@ats.local",
    "FromName": "ATS",
    "UseSsl": false
  },
  "Invitation": {
    "ValidDays": 7,
    "AcceptBaseUrl": "http://localhost:5000/accept-invite"
  },
  "FileStorage": {
    "Endpoint": "localhost:9000",
    "BucketName": "cv-uploads",
    "UseSsl": false,
    "MaxFileSizeBytes": 10485760
  },
  "Hangfire": {
    "ExpiredInvitationCleanupCron": "0 0 * * *"
  }
}

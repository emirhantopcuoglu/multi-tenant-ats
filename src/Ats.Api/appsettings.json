{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "MassTransit": "Warning",
        "Hangfire": "Warning"
      }
    },
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId,-36} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Postgres": "Host=127.0.0.1;Port=5434;Database=ats;Username=ats;Password=ats_dev_password"
  },
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "ats"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "ats",
    "Password": "ats_dev_password",
    "RetryLimit": 5,
    "RetryInitialIntervalSeconds": 2,
    "RetryMaxIntervalSeconds": 30
  },
  "Idempotency": {
    "RetentionHours": 24
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PerIpPermitLimit": 5,
    "PerUserPermitLimit": 60,
    "PerTenantPermitLimit": 100,
    "WindowSeconds": 60
  },
  "Jwt": {
    "Issuer": "ats",
    "Audience": "ats",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "FromAddress": "noreply@ats.local",
    "FromName": "ATS",
    "UseSsl": false
  },
  "Invitation": {
    "ValidDays": 7,
    "AcceptBaseUrl": "http://localhost:5173/accept-invitation"
  },
  "PasswordReset": {
    "ResetBaseUrl": "http://localhost:5173/reset-password",
    "ValidMinutes": 60
  },
  "CandidateEmailChange": {
    "ConfirmBaseUrl": "http://localhost:5173/candidate/confirm-email"
  },
  "CandidatePasswordReset": {
    "ResetBaseUrl": "http://localhost:5173/candidate/reset-password"
  },
  "CandidateEmailVerification": {
    "ConfirmBaseUrl": "http://localhost:5173/candidate/verify-email"
  },
  "EmailConfirmation": {
    "ConfirmBaseUrl": "http://localhost:5173/confirm-email"
  },
  "InterviewRoom": {
    "BaseUrl": "http://localhost:5173/interview-room"
  },
  "FileStorage": {
    "Endpoint": "localhost:9000",
    "BucketName": "cv-uploads",
    "UseSsl": false,
    "MaxFileSizeBytes": 10485760
  },
  "Hangfire": {
    "ExpiredInvitationCleanupCron": "0 0 * * *"
  },
  "OpenTelemetry": {
    "ServiceName": "ats-api",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Llm": {
    "BaseUrl": "https://models.github.ai/inference",
    "Model": "openai/gpt-4o-mini",
    "MaxOutputTokens": 2048,
    "TimeoutSeconds": 30,
    "RetryLimit": 3
  }
}
